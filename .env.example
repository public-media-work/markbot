# markbot secrets — env vars take priority. When a var is unset, markbot falls
# back to the-lodge resolver (scripts/get-secret.sh → registry → 1Password).
# In the cloud (GitHub Actions / Claude routines) set these as secrets/env.
# Names match the-lodge registry (e.g. AIRTABLE_PAT). See docs/SETUP.md.

# Slack Bot User OAuth Token — create the app via the Slack CLI (see SETUP.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# AirTable personal access token — only needed by data-driven recipes
# (e.g. run-alert program-of-the-day). Registry: secret/airtable-api-key.
AIRTABLE_PAT=

# Optional: site URL referenced by podcast-import notifications
PODCAST_SITE_URL=
